{
  "claude-chatter-prime": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "uvx --from git+https://github.com/non7top/claude-chatter-mcp bridge-mcp --prime-hook",
        "timeout": 30
      }
    ]
  },
  "claude-chatter-idle": {
    "Stop": [
      {
        "type": "command",
        "command": "uvx --from git+https://github.com/non7top/claude-chatter-mcp bridge-mcp --stop-hook",
        "timeout": 10
      }
    ]
  }
}
